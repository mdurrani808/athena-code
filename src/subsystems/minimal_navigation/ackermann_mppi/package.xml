<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ackermann_mppi</name>
  <version>0.1.0</version>
  <description>
    Standalone MPPI controller for Ackermann steering robots.
    A minimal extraction of nav2_mppi_controller with the nav2 plugin
    scaffolding removed — no pluginlib, no LifecycleNode dependency,
    no GoalChecker, no OptimalTrajectoryValidator.
    Runs as a plain rclcpp::Node.
  </description>
  <maintainer email="you@example.com">UMD Loop</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>angles</depend>
  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>

  <build_depend>eigen3_cmake_module</build_depend>
  <build_depend>Eigen3</build_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
