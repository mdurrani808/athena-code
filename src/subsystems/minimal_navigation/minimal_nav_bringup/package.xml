<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>minimal_nav_bringup</name>
  <version>0.1.0</version>
  <description>Launch and configuration files for the full Athena navigation stack</description>
  <maintainer email="umdloop@umd.edu">UMD Loop</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>gps_pose_publisher</exec_depend>
  <exec_depend>dem_costmap</exec_depend>
  <exec_depend>athena_smac_planner</exec_depend>
  <exec_depend>ackermann_mppi</exec_depend>
  <exec_depend>mission_executive</exec_depend>
  <exec_depend>athena_gps</exec_depend>
  <exec_depend>twist_stamper</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
