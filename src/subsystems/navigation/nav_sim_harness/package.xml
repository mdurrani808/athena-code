<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nav_sim_harness</name>
  <version>0.1.0</version>
  <description>End-to-end Gazebo test harness for the Athena navigation stack: spawns
    mission artifacts (boxes, ArUco posts), drives scripted scenarios through
    mission_cli, and scores pass/fail off /nav_status, /led_status and
    ground-truth odometry.</description>
  <maintainer email="umdloop@umd.edu">UMD Loop</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <!-- Stacks the harness launches / drives at runtime -->
  <exec_depend>simulation</exec_depend>
  <exec_depend>nav_bringup</exec_depend>
  <exec_depend>description</exec_depend>
  <exec_depend>mission_executive</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
